<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ptorresExamen.Views.vRegistro"
             Title="Registro"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="10">

        <!-- Usuario Conectado -->
        <Label x:Name="lblUsuario"
               Text="Usuario conectado: ..."
               Style="{StaticResource UsuarioStyle}" />

        <!-- Título REGISTRO: AZUL, tamaño 22, centrado (estilo global) -->
        <Label Text="REGISTRO"
               Style="{StaticResource TituloRegistroStyle}" />

        <!-- GRID 2 Filas × 3 Columnas -->
        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*,*"
              RowSpacing="8"
              ColumnSpacing="10"
              Margin="0,10,0,0">

            <Label Grid.Row="0" Grid.Column="0" Text="Nombre" Style="{StaticResource EtiquetaStyle}" />
            <Label Grid.Row="0" Grid.Column="1" Text="Apellido" Style="{StaticResource EtiquetaStyle}" />
            <Label Grid.Row="0" Grid.Column="2" Text="Edad" Style="{StaticResource EtiquetaStyle}" />

            <Entry Grid.Row="1" Grid.Column="0"
                   x:Name="txtNombre"
                   Placeholder="Ingresar Nombre"
                   Style="{StaticResource CajaStyle}" />
            <Entry Grid.Row="1" Grid.Column="1"
                   x:Name="txtApellido"
                   Placeholder="Ingresar Apellido"
                   Style="{StaticResource CajaStyle}" />
            <Entry Grid.Row="1" Grid.Column="2"
                   x:Name="txtEdad"
                   Placeholder="Ingresar Edad"
                   Keyboard="Numeric"
                   Style="{StaticResource CajaStyle}" />
        </Grid>

        <!-- GRID 5 Filas × 2 Columnas -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*"
              RowSpacing="10"
              ColumnSpacing="10"
              Margin="0,10,0,0">

            <!-- Fecha de inicio: DatePicker (no permitir fechas pasadas) -->
            <Label Grid.Row="0" Grid.Column="0" Text="Fecha de inicio" Style="{StaticResource EtiquetaStyle}" />
            <DatePicker Grid.Row="0" Grid.Column="1"
                        x:Name="dateInicio"
                        Format="dd/MM/yyyy"
                        TextColor="#212121"
                        BackgroundColor="#F5F5F5" />

            <!-- Plan: Picker -->
            <Label Grid.Row="1" Grid.Column="0" Text="Plan" Style="{StaticResource EtiquetaStyle}" />
            <Picker Grid.Row="1" Grid.Column="1"
                    x:Name="pickerPlan"
                    Title="Selecciona el plan"
                    TextColor="#212121"
                    TitleColor="#919191">
                <Picker.Items>
                    <x:String>Musculación</x:String>
                    <x:String>Cardio</x:String>
                    <x:String>Crossfit</x:String>
                    <x:String>Full</x:String>
                </Picker.Items>
            </Picker>

            <!-- Casillero: Switch -->
            <Label Grid.Row="2" Grid.Column="0" Text="Casillero" Style="{StaticResource EtiquetaStyle}" />
            <Switch Grid.Row="2" Grid.Column="1"
                    x:Name="swCasillero"
                    HorizontalOptions="Start" />

            <!-- Monto Inicial: Entry (validar entre 120 y 600) -->
            <Label Grid.Row="3" Grid.Column="0" Text="Monto Inicial" Style="{StaticResource EtiquetaStyle}" />
            <Entry Grid.Row="3" Grid.Column="1"
                   x:Name="txtMonto"
                   Placeholder="Entre 120 y 600"
                   Keyboard="Numeric"
                   Style="{StaticResource CajaStyle}" />

            <!-- Botón Calcular Pago mensual | Entry Pago mensual (calculado, bloqueado) -->
            <Button Grid.Row="4" Grid.Column="0"
                    x:Name="btnCalcular"
                    Text="Calcular Pago mensual"
                    Style="{StaticResource BotonStyle}"
                    Clicked="btnCalcular_Clicked" />
            <Entry Grid.Row="4" Grid.Column="1"
                   x:Name="txtPago"
                   Placeholder="Pago mensual"
                   IsReadOnly="True"
                   IsEnabled="False"
                   Style="{StaticResource CajaStyle}" />
        </Grid>

        <!-- Fuera del GRID -->
        <Button x:Name="btnResumen"
                Text="Ver Resumen"
                Style="{StaticResource BotonStyle}"
                Clicked="btnResumen_Clicked" />

        <Label x:Name="lblMensaje"
               TextColor="#DC2626"
               HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>
